APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=publications
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/publications

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=publications
ELASTICSEARCH_ALIAS=publications-read
ELASTICSEARCH_REQUEST_TIMEOUT=10
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ES_JAVA_OPTS=-Xms512m -Xmx512m

INDEXING_CHANNEL=publication-indexing

KIBANA_PORT=5601

API_HOST=0.0.0.0
API_PORT=8000

WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_SECONDS=1
